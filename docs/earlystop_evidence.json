 "post_run_edits": {
  "liconn_v2/earlystop.py": {
   "changed_definitions": [
    "PLATEAU",
    "Recorder",
    "face_errors",
    "frontier",
    "install",
    "non_finite_faces",
    "plateau_stats",
    "run_layout",
    "voxel_flips"
   ],
   "why": "Analysis only, after the runs: float16 NaN face scores are excluded from the error statistics and counted separately; the exploratory plateau statistics were added; after review, the frontier label dropped_at_pop was renamed queued_not_evaluated because the recorder does not see why a queued move is not evaluated. The GPU runs use none of these. Milestone 12 (review finding): the open-loop voxel flip count (voxel_flips, used by Recorder) now counts a non-finite candidate output as changed. The recorded runs used the earlier count, which undercounts NaN outputs; their voxel flip rate is not cited in docs/earlystop_results.md. install() and run_layout() were added to run fp16_head32 through the many-seed runner. Nothing else in Recorder changed."
  },
  "examples/analyze_earlystop.py": {
   "changed_definitions": [
    "analyze"
   ],
   "why": "Reports the NaN counts and the exploratory plateau statistics. Not run on the cluster; re-run by the evidence test."
  },
  "liconn_v2/manyseed.py": {
   "changed_definitions": [
    "fetch_and_select"
   ],
   "why": "Review finding (early-stop check 2): cached crops are verified before the coarse level is downloaded. The early-stop runs only load crops and seeds; they never call fetch_and_select."
  }
 },
